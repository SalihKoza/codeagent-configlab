{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codeagent-configlab/schemas/run-manifest/v0",
  "title": "CodeAgent ConfigLab run manifest (V0)",
  "description": "Immutable specification of ONE experimental run = (task, configuration, repetition). Planned inputs only; observed outputs live in the run-result schema. Contains no secret or token fields. OPEN fields carry the string \"OPEN\" (undecided, must be frozen before final runs); not-applicable fields are null. See docs/RUN_MANIFEST_V0.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "task_version_hash", "language",
    "task_category", "configuration", "repetition", "order_position", "order_seed_ref",
    "workspace_token", "claude_code_version", "node_version", "npm_version",
    "sandbox_runtime_version", "model_request", "effort_request", "permission_mode",
    "implementation_tool_set", "planning_tool_set", "settings_policy_hash",
    "security_policy_hash", "task_statement_hash", "claude_md_hash",
    "planning_wrapper_hash", "approval_message_hash", "timeout_seconds", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "run-manifest/v0" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "task_version_hash": { "type": "string" },
    "language": { "enum": ["python", "typescript"] },
    "task_category": { "enum": ["bugfix", "feature", "refactor"] },
    "configuration": { "enum": ["C0", "C1", "C2"] },
    "repetition": { "type": "integer" },
    "order_position": { "oneOf": [ { "type": "null" }, { "type": "integer" } ] },
    "order_seed_ref": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "workspace_token": { "type": "string" },
    "claude_code_version": { "type": "string" },
    "node_version": { "type": "string" },
    "npm_version": { "type": "string" },
    "sandbox_runtime_version": { "type": "string" },
    "model_request": { "type": "string", "description": "Model value passed to every run. The string \"OPEN\" until frozen (O5); otherwise a real model id. Always a string, so the OPEN-vs-frozen distinction is semantic, not structural." },
    "effort_request": { "type": "string", "description": "Effort level passed to every run via --effort. The string \"OPEN\" until frozen; otherwise one of low/medium/high/xhigh/max." },
    "permission_mode": { "type": "string" },
    "implementation_tool_set": { "type": "array", "items": { "type": "string" } },
    "planning_tool_set": {
      "oneOf": [ { "type": "null" }, { "type": "array", "items": { "type": "string" } } ]
    },
    "settings_policy_hash": { "type": "string" },
    "security_policy_hash": { "type": "string" },
    "task_statement_hash": { "type": "string" },
    "claude_md_hash": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "planning_wrapper_hash": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "approval_message_hash": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "timeout_seconds": { "oneOf": [ { "const": "OPEN" }, { "type": "number" } ] },
    "created_at": { "type": "string" },
    "namespace": { "enum": ["PILOT", "HARNESS_SMOKE_ONLY", "FINAL"], "description": "G10 (optional, additive v0): experiment namespace; absent outside a series." },
    "series_id": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "series_spec_hash": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "cell_id": { "oneOf": [ { "type": "null" }, { "type": "string" } ], "description": "G10: planned task x configuration x repetition cell; run_id is the attempt id." },
    "attempt_ordinal": { "oneOf": [ { "type": "null" }, { "type": "integer" } ] },
    "attempt_kind": { "oneOf": [ { "type": "null" }, { "enum": ["original", "replacement"] } ] },
    "original_attempt_id": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "predecessor_attempt_id": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
    "replacement_reason": { "oneOf": [ { "type": "null" }, { "type": "string" } ] }
  }
}
