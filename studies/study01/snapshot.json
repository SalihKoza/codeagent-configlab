{
  "payload": {
    "analysis": {
      "agent_time_binding": {
        "c0_c1": "process.json -> elapsed_seconds",
        "c2_phase1": "c2.json -> phases[label == 'phase1'].process.elapsed_seconds",
        "c2_phase2": "c2.json -> phases[label == 'phase2'].process.elapsed_seconds; not started (c2.json.invocations == 1) is reported as not started, never 0",
        "c2_total": "phase1 + phase2 agent elapsed (phase 1 only if phase 2 did not start)",
        "excluded": "c2.json.inter_phase_gap_seconds; evaluator, cleanup and lifecycle time; result.json.duration_seconds and c2.json.phases[].duration_seconds are not the performance metric",
        "timeout": "result.json agent_outcome == 'timeout' with run_validity == 'valid'; process timed_out true, termination 'timeout_terminated', deadline_budget_seconds; a missing process record is missing, never 0"
      },
      "replacement_policy": {
        "ordering": "approved replacement attempts run only after all 54 planned original cells have been attempted, in schedule order (Series._next), never at the end of the current block",
        "rule": "C-a: pilot-validated policy unchanged (series.replacement_decision): countable -> complete, no replacement; evaluation_pending -> evaluator re-evaluation on the preserved final working copy, never an agent rerun; external interruption / invalid:infrastructure / invalid:harness / preflight_failed -> operator-approved replacement only; invalid:fixture -> replacement only with an operator note; invalid:leak / invalid:carryover / invalid:c2_protocol+phase1_write -> series halt (hard stop); real cleanup failure -> recoverable halt; anything else -> no_valid_attempt; at most one replacement per cell; no outcome-quality reruns; every attempt preserved; replacements never increase planned N",
        "spec_replacement_policy": {
          "eligible_external_interruption": true,
          "eligible_run_validity": [
            "invalid:infrastructure",
            "invalid:harness",
            "preflight_failed"
          ],
          "halt_run_validity": [
            "invalid:leak",
            "invalid:carryover"
          ],
          "max_replacements_per_cell": 1,
          "operator_approval_required": true,
          "operator_confirm_run_validity": [
            "invalid:fixture"
          ]
        }
      },
      "results_presentation": {
        "key_rules": [
          "task-by-task results first",
          "planned-cell denominator: R resolved · F failed · M no countable observation / N planned",
          "separate attempt / replacement / non-countable accounting",
          "18 planned cells per configuration, 54 overall",
          "primary contrasts RQ1 = C1 - C0 and RQ2 = C2 - C1; C2 - C0 descriptive only",
          "agent time over all countable attempts with success/failure/timeout visible",
          "C2 phase 1 + phase 2 breakdown and total",
          "source-scoped changed files and diff size descriptive only",
          "no weighted composite score",
          "no significance or generalization claim unsupported by the six-task design"
        ],
        "rule": "C-c: STUDY_01_PROTOCOL.md §8 adopted unchanged"
      },
      "source_scope_rule": {
        "excluded": {
          "python": [
            "tests/**",
            "_hidden_tests/**",
            "README.md",
            "CLAUDE.md",
            ".claude/**",
            "**/__pycache__/**",
            ".pytest_cache/**",
            "every path outside the scope directory"
          ],
          "typescript": [
            "test/**",
            "_hidden_tests/**",
            "dist/**",
            "*.tsbuildinfo",
            "node_modules/**",
            "package.json",
            "package-lock.json",
            "tsconfig.json",
            "README.md",
            "CLAUDE.md",
            ".claude/**",
            "every path outside src/"
          ]
        },
        "membership": "a path counts only if it matches the task's source scope and is not excluded",
        "rule_1_renames": "a rename counts as a changed source file when either the old or the new path is inside the scope",
        "rule_2_unavailable_line_delta": "if the textual line delta is unavailable (whole final.diff withheld, or an entry marked 'binary or oversized file; not inlined' / 'start content unavailable; not inlined'), an in-scope file still counts as changed and its line delta is recorded as unknown/withheld, never 0; withheld changed_files path names make scope membership unknown",
        "rule_3": "changed-file count and diff size are descriptive only, never a quality metric"
      },
      "token_usage": "S10: EXCLUDED FROM FORMAL STUDY-01 METRICS; raw usage fields/events are preserved when present; missing usage is never 0; total_cost_usd is not a billed cost under Claude Pro",
      "unnecessary_change_rubric": "S11: EXCLUDED FROM FORMAL STUDY-01 METRICS; no frozen rubric exists; no weighted or composite quality score"
    },
    "evaluator_identity_rule": "Gate-5 S8: a task's binding evaluator identity is its evaluator_identity + evaluator sandbox semantic version g5s-v2 + harness_git_sha. Runtime sandbox policy_hash values contain absolute paths and are provenance only, never a snapshot key.",
