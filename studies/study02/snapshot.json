      "replacement_policy": {
        "ordering": "approved replacement attempts run only after all 48 planned original cells have been attempted, in schedule order (Series._next), never at the end of the current block",
        "rule": "series.replacement_decision, unchanged from Study-01: countable -> complete, no replacement; evaluation_pending -> evaluator re-evaluation on the preserved final working copy, never an agent rerun; external interruption / invalid:infrastructure / invalid:harness / preflight_failed -> operator-approved replacement only; invalid:fixture -> operator confirmation required, distinct from automatic replacement; invalid:leak / invalid:carryover -> series halt; at most one replacement per cell; no outcome-quality reruns; every attempt preserved; replacements never increase planned N",
        "spec_replacement_policy": {
          "eligible_external_interruption": true,
          "eligible_run_validity": [
            "invalid:infrastructure",
            "invalid:harness",
            "preflight_failed"
