            "invalid:leak",
            "invalid:carryover"
          ],
          "max_replacements_per_cell": 1,
          "operator_approval_required": true,
          "operator_confirm_run_validity": [
            "invalid:fixture"
          ]
        }
      },
      "research_question": "Under an identical frozen repository CLAUDE.md for each task and fully candidate-visible task constraints, does the explicit two-phase plan-then-approve workflow (C2) change contract-compliant task completion relative to the same substantive CLAUDE.md without that workflow (C1) on a new set of 12 distinct coding tasks across six repository families?",
      "results_presentation": {
        "key_rules": [
          "task-by-task results first",
          "planned-cell denominator: R resolved . F failed . M no countable observation / N planned",
          "separate attempt / replacement / non-countable accounting",
          "24 planned cells per configuration, 48 overall",
          "48 planned cells does not necessarily imply 48 countable observations",
          "primary contrast C2 - C1",
          "agent time over all countable attempts with success/failure/timeout visible",
          "C2 phase 1 + phase 2 breakdown and total",
          "no weighted composite score",
          "no significance or generalization claim unsupported by the 12-task, 6-family design"
        ]
      },
      "secondary_endpoints_preregistered": [
        "functional_pass (valid AND acceptance=pass AND regression=pass; integrity reported separately, remains part of primary resolved)",
        "acceptance",
        "regression",
        "integrity",
        "total candidate time",
        "C2 phase-1 candidate time",
        "C2 phase-2 candidate time",
        "task-level resolved count out of 2",
        "paired task x repetition transitions"
